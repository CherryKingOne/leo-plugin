{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CherryKingOne/leo-plugin/schemas/leo-plugin.schema.json",
  "title": "leo plugin manifest",
  "type": "object",
  "required": [
    "id",
    "package",
    "version",
    "status",
    "description",
    "leo",
    "entry",
    "install"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "package": {
      "type": "string",
      "pattern": "^leo-plugin-[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "leo": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "bundle": {
      "type": "string"
    },
    "inject": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provides": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "install": {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {}
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "example": {}
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "description": "由 scripts/release.mjs 写入，请勿手改",
      "required": [
        "version",
        "bundle"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "bundle": {
          "type": "object",
          "required": [
            "url",
            "sha256"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "init": {
          "type": "object",
          "description": "由 scripts/release.mjs 写入：已发布模板的地址与 sha256",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "url",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "init": {
      "type": "object",
      "description": "`leo plugin add <id> --init` 时写进 .leo/（全局 ~/.leo 或项目 .leo）的配置文件模板",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "template"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "相对 .leo/ 的目标路径，如 mcp-servers.json、agents/explorer.md；不能越出 .leo/"
              },
              "template": {
                "type": "string",
                "description": "插件目录内的模板文件，如 templates/mcp-servers.json（npm 包需在 files 中包含）"
              },
              "description": {
                "type": "string",
                "description": "安装时打印的说明"
              }
            }
          }
        }
      }
    },
    "purge": {
      "type": "object",
      "description": "`leo plugin remove <id> --purge` 时额外清理的内容（需要 leo-agents 支持 purge 的版本；旧版忽略）",
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "type": "array",
          "description": "scope 目录 credentials.json 里由插件写入的键；以 / 结尾表示前缀（如 gateway/qq/）",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": false
}
