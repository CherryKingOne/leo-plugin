{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "leo plugin registry",
  "type": "object",
  "required": [
    "plugins"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "package",
          "path",
          "version",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "experimental",
              "stable",
              "deprecated"
            ]
          },
          "description": {
            "type": "string"
          },
          "leo": {
            "type": "string",
            "description": "兼容的 leo-agents 版本范围，如 >=0.1.0"
          },
          "bundle": {
            "type": "object",
            "required": [
              "url",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "单文件下载地址；相对地址以 registry.json 为基准"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "init": {
            "type": "object",
            "description": "`leo plugin add --init` 下载的配置文件模板",
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "相对 .leo/ 的目标路径"
                    },
                    "url": {
                      "type": "string",
                      "description": "模板地址，可相对 registry.json"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string",
                      "description": "内联模板内容（与 url 二选一）"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "const": 1
    }
  }
}
