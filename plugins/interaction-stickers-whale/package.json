{
  "name": "leo-plugin-interaction-stickers-whale",
  "version": "0.1.0",
  "description": "leo 互动层的表情包子插件：鲸鱼娘表情 24 张 × 蓝 / 黑两套角色，终端字符画 + 图片，移植自 dsh-stickers",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/CherryKingOne/leo-plugin.git",
    "directory": "plugins/interaction-stickers-whale"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "leo-plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:leo-agents --outfile=dist/interaction-stickers-whale.bundle.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "leo-agents": ">=0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "leo-agents": "github:CherryKingOne/leo-agents#fc1a081",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
