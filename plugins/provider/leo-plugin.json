{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "provider",
  "package": "leo-plugin-provider",
  "version": "0.3.1",
  "status": "experimental",
  "description": "模型供应商注册层：子插件（provider-deepseek 等）注册驱动，统一读配置、取密钥、接入 Agent；自带通用 OpenAI 兼容协议，任意兼容端点写 baseURL 即可（需要 leo ≥ 0.2.0）",
  "keywords": [
    "provider",
    "llm",
    "model",
    "openai-compatible"
  ],
  "leo": ">=0.2.0",
  "entry": "./dist/index.js",
  "bundle": "./dist/provider.bundle.js",
  "inject": [
    "llm"
  ],
  "provides": {
    "services": [
      "providers"
    ],
    "tools": [],
    "events": []
  },
  "permissions": [
    "net.connect"
  ],
  "install": {
    "config": "leo-plugin-provider",
    "example": [
      "leo-plugin-provider",
      {
        "model": "deepseek/deepseek-flash"
      }
    ]
  },
  "init": {
    "files": [
      {
        "path": "provider.json",
        "template": "templates/provider.json",
        "description": "模型供应商配置：默认模型、各厂商的 baseURL / 模型 / 密钥引用；装了子插件并保存密钥的厂商会自动接入"
      }
    ]
  },
  "release": {
    "version": "0.3.0",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/provider/0.3.0/provider.bundle.js",
      "sha256": "5f06de697559050e1ec83f9364c360cd92cab965b7dccb246c655b614187f41e"
    },
    "init": {
      "files": [
        {
          "path": "provider.json",
          "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/provider/0.3.0/init/provider.json",
          "sha256": "25b594bdc54843991698cda0ef6a1874d4ef2e29ffd759310103d0341c8466ec",
          "description": "模型供应商配置：默认模型、各厂商的 baseURL / 模型 / 密钥引用；装了子插件并保存密钥的厂商会自动接入"
        }
      ]
    }
  }
}
