{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "mcp",
  "package": "leo-plugin-mcp",
  "version": "0.1.0",
  "status": "experimental",
  "description": "MCP 客户端：把外部 MCP 服务器的工具接入 Agent，兼容 MCP 2026-07-28（MCP 2.0）与 2025-11-25 及更早版本",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tools"
  ],
  "leo": ">=0.1.0",
  "entry": "./dist/index.js",
  "bundle": "./dist/mcp.bundle.js",
  "inject": [
    "tools"
  ],
  "provides": {
    "services": [
      "mcp"
    ],
    "tools": [],
    "events": [
      "mcp/connected",
      "mcp/error"
    ]
  },
  "permissions": [
    "mcp.call",
    "process.spawn",
    "net.connect"
  ],
  "install": {
    "config": "leo-plugin-mcp",
    "example": [
      "leo-plugin-mcp",
      {
        "timeoutMs": 120000
      }
    ]
  },
  "init": {
    "files": [
      {
        "path": "mcp-servers.json",
        "template": "templates/mcp-servers.json",
        "description": "MCP 服务器列表，取消注释或粘贴 mcpServers 即可使用"
      }
    ]
  },
  "release": {
    "version": "0.1.0",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/mcp/0.1.0/mcp.bundle.js",
      "sha256": "ad01420f4976072cda6f64772545c70e94e7a6e62683c660b869773365df3811"
    },
    "init": {
      "files": [
        {
          "path": "mcp-servers.json",
          "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/mcp/0.1.0/init/mcp-servers.json",
          "sha256": "2bb14b44f84ec7c02884d51b48f1839169b2e3617dbe69520cb43fad60538cc0",
          "description": "MCP 服务器列表，取消注释或粘贴 mcpServers 即可使用"
        }
      ]
    }
  }
}
