{
  "name": "leo-plugin-mcp",
  "version": "0.1.0",
  "description": "MCP 客户端：把外部 MCP 服务器的工具接入 leo Agent，同时兼容 MCP 2026-07-28（无状态，俗称 MCP 2.0）与 2025-11-25 及更早的握手版本",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CherryKingOne/leo-plugin.git",
    "directory": "plugins/mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "leo-plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:leo-agents --outfile=dist/mcp.bundle.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "leo-agents": ">=0.1.0"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "leo-agents": "github:CherryKingOne/leo-agents#f73f7c9",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
