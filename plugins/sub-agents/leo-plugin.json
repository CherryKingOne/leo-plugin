{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "sub-agents",
  "package": "leo-plugin-sub-agents",
  "version": "0.1.0",
  "status": "experimental",
  "description": "子代理：把任务委派给独立上下文的子 Agent 执行并汇总结果",
  "keywords": [
    "agent",
    "sub-agent",
    "delegation"
  ],
  "leo": ">=0.1.0",
  "entry": "./dist/index.js",
  "bundle": "./dist/sub-agents.bundle.js",
  "inject": [
    "agentLoop",
    "tools"
  ],
  "provides": {
    "services": [
      "subAgents"
    ],
    "tools": [
      "task"
    ],
    "events": [
      "sub-agents/started",
      "sub-agents/finished"
    ]
  },
  "permissions": [
    "agent.spawn"
  ],
  "install": {
    "config": "leo-plugin-sub-agents",
    "example": [
      "leo-plugin-sub-agents",
      {
        "maxConcurrent": 4
      }
    ]
  },
  "release": {
    "version": "0.1.0",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/sub-agents/0.1.0/sub-agents.bundle.js",
      "sha256": "7cb2ea40b8f1ae34607a34ce384fef23fb97305a9f356d3121b5583a1e6ee199"
    }
  }
}
