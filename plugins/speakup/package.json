{
  "name": "leo-plugin-speakup",
  "version": "0.1.1",
  "description": "leo 主动搭话：对方一阵子没来找时，Agent 在私聊里主动找对方说几句；问了话没回会轻轻追一句（经消息网关发出）",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CherryKingOne/leo-plugin.git",
    "directory": "plugins/speakup"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "leo-plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:leo-agents --outfile=dist/speakup.bundle.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "leo-agents": ">=0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "leo-agents": "github:CherryKingOne/leo-agents#fc1a081",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}
