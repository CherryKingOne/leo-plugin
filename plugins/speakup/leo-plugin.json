{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "speakup",
  "package": "leo-plugin-speakup",
  "version": "0.1.1",
  "status": "experimental",
  "description": "主动搭话：对方一阵子没来找时，Agent 在私聊里主动找对方说几句，问了话没回会轻轻追一句；清醒时段、空闲时长、每天次数可配，经消息网关作为主动消息发出（需要 gateway ≥ 0.3.0；/speakup 命令需要 leo-agents ≥ 0.2.1）",
  "keywords": [
    "speakup",
    "proactive",
    "主动消息",
    "主动搭话",
    "gateway"
  ],
  "leo": ">=0.1.2",
  "entry": "./dist/index.js",
  "bundle": "./dist/speakup.bundle.js",
  "inject": [
    "gateway"
  ],
  "provides": {
    "services": [
      "speakup"
    ],
    "tools": [],
    "events": []
  },
  "permissions": [],
  "install": {
    "config": "leo-plugin-speakup",
    "example": [
      "leo-plugin-speakup",
      {}
    ]
  },
  "init": {
    "files": [
      {
        "path": "speakup.json",
        "template": "templates/speakup.json",
        "description": "主动搭话配置：找谁、清醒时段、空闲多久、每天几次、追问"
      }
    ]
  },
  "release": {
    "version": "0.1.1",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/speakup/0.1.1/speakup.bundle.js",
      "sha256": "f5f5bbfc83e8d368d7749c0f97284bef63b831580621050720023153046168dc"
    },
    "init": {
      "files": [
        {
          "path": "speakup.json",
          "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/speakup/0.1.1/init/speakup.json",
          "sha256": "fbbe361c662f42f2d51a1408c55e53cd4488f75c39bf94146306347a7e3ba8d1",
          "description": "主动搭话配置：找谁、清醒时段、空闲多久、每天几次、追问"
        }
      ]
    }
  }
}
