{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "chat-channels",
  "package": "leo-plugin-chat-channels",
  "version": "0.2.0",
  "status": "experimental",
  "description": "聊天渠道注册层：统一注册、配置与管理聊天渠道子插件，内置 QQ、飞书、Telegram 机器人",
  "keywords": [
    "chat",
    "channel",
    "bot",
    "qq",
    "feishu",
    "lark",
    "telegram"
  ],
  "leo": ">=0.1.0",
  "entry": "./dist/index.js",
  "bundle": "./dist/chat-channels.bundle.js",
  "inject": [
    "tools"
  ],
  "provides": {
    "services": [
      "chatChannels"
    ],
    "tools": [
      "chat_channels",
      "chat_send"
    ],
    "events": [
      "chat-channels/driver-registered",
      "chat-channels/status",
      "chat-channels/received",
      "chat-channels/inbound",
      "chat-channels/sent"
    ]
  },
  "permissions": [
    "chat.send"
  ],
  "install": {
    "config": "leo-plugin-chat-channels",
    "example": [
      "leo-plugin-chat-channels",
      {
        "accounts": {
          "tg-main": {
            "channel": "telegram",
            "options": {
              "botToken": "$TELEGRAM_BOT_TOKEN"
            }
          }
        },
        "agent": {
          "enabled": true,
          "model": "deepseek/deepseek-chat"
        }
      }
    ]
  },
  "release": {
    "version": "0.2.0",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/chat-channels/0.2.0/chat-channels.bundle.js",
      "sha256": "01024240980a192f24603e70c638a2eaaf93bc7058443f6a6263f2ac59bc191f"
    }
  }
}
