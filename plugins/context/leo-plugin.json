{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "context",
  "package": "leo-plugin-context",
  "version": "0.1.0",
  "status": "experimental",
  "description": "上下文观测：每次请求的上下文由什么组成（System 片段、插件注入、工具定义、消息分类）、离窗口和自动压缩多远、怎么演变；跨会话用量、成本与工具洞察。独立本机网页（默认 18792）+ /context，只读",
  "keywords": [
    "context",
    "observability",
    "tokens",
    "cost",
    "insight"
  ],
  "leo": ">=0.2.1",
  "entry": "./dist/index.js",
  "bundle": "./dist/context.bundle.js",
  "inject": [
    "sessions"
  ],
  "provides": {
    "services": [
      "contextInsight"
    ]
  },
  "permissions": [
    "net.listen"
  ],
  "install": {
    "config": "leo-plugin-context",
    "example": [
      "leo-plugin-context",
      {
        "port": 18792
      }
    ]
  },
  "release": {
    "version": "0.1.0",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/context/0.1.0/context.bundle.js",
      "sha256": "124317664215dd0cbfb8795fb1a13ade3d48676d4710de0390cd42a256ee0982"
    }
  }
}
