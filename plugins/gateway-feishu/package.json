{
  "name": "leo-plugin-gateway-feishu",
  "version": "0.2.3",
  "description": "leo 消息网关的飞书子插件：飞书 / Lark 机器人渠道驱动（长连接 / webhook），支持飞书扫码一键创建应用，扫码人自动成为管理员，替代网关内置的飞书驱动",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CherryKingOne/leo-plugin.git",
    "directory": "plugins/gateway-feishu"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "leo-plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:leo-agents --outfile=dist/gateway-feishu.bundle.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "leo-agents": ">=0.1.0"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "leo-agents": "github:CherryKingOne/leo-agents#921b284",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/qrcode-terminal": "^0.12.2"
  }
}
