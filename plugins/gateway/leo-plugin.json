{
  "$schema": "../../schemas/leo-plugin.schema.json",
  "id": "gateway",
  "package": "leo-plugin-gateway",
  "version": "0.2.0",
  "status": "experimental",
  "description": "消息网关：常驻接入 Telegram / 飞书 / QQ，按会话路由给 Agent，授权配对、聊天内审批、主动投递，HTTP / WebSocket / OpenAI 兼容控制面",
  "keywords": [
    "gateway",
    "telegram",
    "feishu",
    "lark",
    "qq",
    "chatbot",
    "openai-compatible"
  ],
  "leo": ">=0.1.0",
  "entry": "./dist/index.js",
  "bundle": "./dist/gateway.bundle.js",
  "inject": [
    "tools"
  ],
  "provides": {
    "services": [
      "gateway"
    ],
    "tools": [
      "gateway_status",
      "gateway_send",
      "gateway_pair"
    ],
    "events": [
      "gateway/message",
      "gateway/turn-start",
      "gateway/turn-end",
      "gateway/sent",
      "gateway/status",
      "gateway/pairing-requested",
      "gateway/paired",
      "gateway/session-reset"
    ]
  },
  "permissions": [
    "gateway.send",
    "gateway.pair",
    "net.listen",
    "net.connect"
  ],
  "install": {
    "config": "leo-plugin-gateway",
    "example": [
      "leo-plugin-gateway",
      {
        "server": {
          "port": 18790
        }
      }
    ]
  },
  "init": {
    "files": [
      {
        "path": "gateway.json",
        "template": "templates/gateway.json",
        "description": "网关配置：聊天平台机器人、授权、会话策略、控制面端口；取消注释并填入机器人凭证即可"
      }
    ]
  },
  "release": {
    "version": "0.2.0",
    "bundle": {
      "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/gateway/0.2.0/gateway.bundle.js",
      "sha256": "3ea7d7e3bc3bd1bae5f437d39e839c28d00a149f070468362eaecbca0a1344e0"
    },
    "init": {
      "files": [
        {
          "path": "gateway.json",
          "url": "https://raw.githubusercontent.com/CherryKingOne/leo-plugin/bundles/gateway/0.2.0/init/gateway.json",
          "sha256": "999e4d0825edcdbf2b84a8d07f36516bd292f220bd1265fa7de79d736455571d",
          "description": "网关配置：聊天平台机器人、授权、会话策略、控制面端口；取消注释并填入机器人凭证即可"
        }
      ]
    }
  }
}
