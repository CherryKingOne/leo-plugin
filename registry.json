{
  "plugins": [
    {
      "bundle": "./dist/agent-team.bundle.js",
      "description": "Agent 团队：Leader、产品经理、产品设计、技术负责人、全栈开发、QA 组成常驻团队，按 PRD → 设计 → 开发 → 测试 → 交付推进，关卡处请用户审批",
      "entry": "./dist/index.js",
      "id": "agent-team",
      "inject": [
        "agentLoop",
        "tools"
      ],
      "install": {
        "config": "leo-plugin-agent-team",
        "example": [
          "leo-plugin-agent-team",
          {
            "gates": {
              "design": false
            },
            "maxBounces": 3,
            "roles": {
              "qa": {
                "model": "deepseek/deepseek-flash"
              }
            }
          }
        ]
      },
      "keywords": [
        "agent",
        "team",
        "multi-agent",
        "workflow",
        "prd",
        "qa"
      ],
      "leo": ">=0.1.2",
      "package": "leo-plugin-agent-team",
      "permissions": [
        "agent.spawn"
      ],
      "provides": {
        "events": [
          "agent-team/phase-started",
          "agent-team/phase-finished",
          "agent-team/bounced",
          "agent-team/awaiting-approval",
          "agent-team/finished"
        ],
        "services": [
          "agentTeam"
        ],
        "tools": [
          "team_start",
          "team_reply",
          "team_assign",
          "team_board",
          "team_artifact",
          "team_request_approval",
          "team_deliver",
          "team_ask",
          "team_task_update"
        ]
      },
      "status": "experimental",
      "version": "0.1.0"
    },
    {
      "bundle": "./dist/context.bundle.js",
      "description": "上下文观测：每次请求的上下文由什么组成（System 片段、插件注入、工具定义、消息分类）、离窗口和自动压缩多远、怎么演变；跨会话用量、成本与工具洞察。独立本机网页（默认 18792）+ /context，只读",
      "entry": "./dist/index.js",
      "id": "context",
      "inject": [
        "sessions"
      ],
      "install": {
        "config": "leo-plugin-context",
        "example": [
          "leo-plugin-context",
          {
            "port": 18792
          }
        ]
      },
      "keywords": [
        "context",
        "observability",
        "tokens",
        "cost",
        "insight"
      ],
      "leo": ">=0.2.1",
      "package": "leo-plugin-context",
      "permissions": [
        "net.listen"
      ],
      "provides": {
        "services": [
          "contextInsight"
        ]
      },
      "status": "experimental",
      "version": "0.1.0"
    },
    {
      "bundle": "./dist/gateway.bundle.js",
      "description": "消息网关：常驻接入 Telegram / 飞书 / QQ，按会话路由给 Agent，授权配对、聊天内审批、主动投递，Agent 发的表情 / 图片发到聊天里，转发插件斜杠命令，HTTP / WebSocket / OpenAI 兼容控制面",
      "entry": "./dist/index.js",
      "id": "gateway",
      "inject": [
        "tools"
      ],
      "install": {
        "config": "leo-plugin-gateway",
        "example": [
          "leo-plugin-gateway",
          {
            "server": {
              "port": 18790
            }
          }
        ]
      },
      "keywords": [
        "gateway",
        "telegram",
        "feishu",
        "lark",
        "qq",
        "chatbot",
        "openai-compatible"
      ],
      "leo": ">=0.1.0",
      "package": "leo-plugin-gateway",
      "permissions": [
        "gateway.send",
        "gateway.pair",
        "net.listen",
        "net.connect"
      ],
      "provides": {
        "events": [
          "gateway/message",
          "gateway/turn-start",
          "gateway/turn-end",
          "gateway/sent",
          "gateway/status",
          "gateway/pairing-requested",
          "gateway/paired",
          "gateway/session-reset"
        ],
        "services": [
          "gateway"
        ],
        "tools": [
          "gateway_status",
          "gateway_send",
          "gateway_pair"
        ]
      },
      "status": "experimental",
      "version": "0.3.1"
    },
    {
      "bundle": "./dist/gateway-feishu.bundle.js",
      "description": "消息网关的飞书子插件：飞书 / Lark 机器人渠道驱动，支持飞书扫码一键创建应用、扫码人自动成为管理员、图片消息，替代网关内置飞书驱动（需要 gateway ≥ 0.2.0，自动授权需要 ≥ 0.2.2，发图片需要 ≥ 0.3.0）",
      "entry": "./dist/index.js",
      "id": "gateway-feishu",
      "inject": [
        "gateway",
        "tools"
      ],
      "install": {
        "config": "leo-plugin-gateway-feishu",
        "example": [
          "leo-plugin-gateway-feishu",
          {
            "qrConsole": true
