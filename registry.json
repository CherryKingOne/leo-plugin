      },
      "keywords": [
        "gateway",
        "feishu",
        "lark",
        "qr",
        "chatbot"
      ],
      "leo": ">=0.1.0",
      "package": "leo-plugin-gateway-feishu",
      "permissions": [
        "gateway.bind",
        "net.connect"
      ],
      "provides": {
        "tools": [
          "gateway_feishu_bind"
        ]
      },
      "status": "experimental",
      "version": "0.3.0"
    },
    {
      "bundle": "./dist/gateway-qq.bundle.js",
      "description": "消息网关的 QQ 子插件：QQ 官方机器人渠道驱动，支持手机 QQ 扫码绑定与图片消息，替代网关内置 QQ 驱动（需要 gateway ≥ 0.2.0，发图片需要 ≥ 0.3.0）",
      "entry": "./dist/index.js",
      "id": "gateway-qq",
      "inject": [
        "gateway",
        "tools"
      ],
      "install": {
        "config": "leo-plugin-gateway-qq",
