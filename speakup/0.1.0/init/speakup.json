{
  // leo 主动搭话配置（leo-plugin-speakup）。项目里的 .leo/speakup.json 覆盖这里。改完自动生效。

  // 总开关
  "enabled": true,

  // 找谁说话：会话键或前缀。空 = 所有私聊（对方先给机器人发过消息才有会话）
  // 例："qq" = 所有 QQ 私聊；"qq:main:direct:<openid>" = 某一个人（/speakup 能看到会话键）
  // 群聊要写出完整前缀，如 "qq:main:group:<group_openid>"（QQ 群还需群主打开「机器人主动在群聊内发言」）
  "targets": [],

  // 双方多久没来往（分钟）才主动找
  "idleMinutes": 120,
  // 两次主动搭话之间的随机间隔（分钟）
  "minIntervalMinutes": 90,
  "maxIntervalMinutes": 240,
  // 每个会话每天最多主动找几次；0 = 只追问、不主动找
  "maxPerDay": 3,

  // 清醒时段：这几点之间才会主动找（22 ~ 2 这样跨午夜也行）
  "awakeFrom": 9,
  "awakeTo": 23,
  // 时段与「每天」按哪个时区算；空 = 系统时区
  "timezone": "Asia/Shanghai",

  // 追问：Agent 上一句在问对方、对方 15 ~ 40 分钟没回时，有一半机会轻轻追一句（不占每天次数）
  "nudge": true,
  "nudgeMinMinutes": 15,
  "nudgeMaxMinutes": 40,

  // 提示词里怎么称呼对方；空 = 用平台昵称，没有就叫「对方」
  "name": ""
}
